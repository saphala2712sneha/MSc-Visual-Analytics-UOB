  <dashboards>
    <dashboard enable-sort-zone-taborder='true' name='Dashboard 1 - 2011 Health Inequality Baseline'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='22'>Dashboard 1: 2011 Health Inequality Baseline</run>
            <run>Æ&#10;</run>
            <run fontsize='9'>Where were poor health outcomes concentrated in 2011, and did those areas also show unemployment, low education, or poorer housing conditions?</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <style />
      <size sizing-mode='automatic' />
      <datasources>
        <datasource name='Parameters' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='p_Socioeconomic Factor' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;No qualification&quot;'>
          <calculation class='tableau' formula='&quot;No qualification&quot;' />
          <members>
            <member value='&quot;Unemployment&quot;' />
            <member value='&quot;No qualification&quot;' />
            <member value='&quot;Social rented housing&quot;' />
            <member value='&quot;Private rented housing&quot;' />
            <member value='&quot;Long-term sick/disabled&quot;' />
          </members>
        </column>
        <column caption='p_Value View' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Percentage&quot;'>
          <calculation class='tableau' formula='&quot;Percentage&quot;' />
          <members>
            <member value='&quot;Percentage&quot;' />
            <member value='&quot;Absolute Count&quot;' />
          </members>
        </column>
      </datasource-dependencies>
