          <alias key='&quot;[federated.0mk6vgd01e6r9u10izgty04z1bbb].[avg:pct_social_rented_total:qk]&quot;' value=' Social Rented' />
          <alias key='&quot;[federated.0mk6vgd01e6r9u10izgty04z1bbb].[avg:pct_unemployed:qk]&quot;' value='Unemployment' />
        </aliases>
      </column>
      <column caption='National Poor Health %' datatype='real' name='[Calculation_1344217378820096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([n_bad_or_very_bad])/SUM([total_persons_health]))*100' />
      </column>
      <column caption='Above National Poor Health Flag' datatype='integer' name='[Calculation_1344217379205121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [pct_bad_or_very_bad] &gt;&#13;&#10;(&#13;&#10;    {SUM([n_bad_or_very_bad]) }&#13;&#10;    /&#13;&#10;    {SUM([total_persons_health]) }&#13;&#10;    * 100&#13;&#10;)&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Selected Socioeconomic Factor%' datatype='real' name='[Calculation_1344217393897474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Unemployment&quot; THEN [pct_unemployed]&#13;&#10;WHEN &quot;No qualification&quot; THEN [pct_no_qualifications]&#13;&#10;WHEN &quot;Social rented housing&quot; THEN [pct_social_rented_total]&#13;&#10;WHEN &quot;Private rented housing&quot; THEN [pct_private_rented_total]&#13;&#10;WHEN &quot;Long-term sick/disabled&quot; THEN [pct_long_term_sick_disabled]&#13;&#10;END' />
      </column>
      <column caption='Selected Poor Health Measure' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1722724623671308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Percentage&quot; THEN&#13;&#10;    [pct_bad_or_very_bad]&#13;&#10;ELSE&#13;&#10;    [n_bad_or_very_bad]&#13;&#10;END' />
      </column>
      <column caption='Selected Poor Health Unit' datatype='string' name='[Calculation_1722724623826957]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Percentage&quot; THEN&#13;&#10;    &quot;%&quot;&#13;&#10;ELSE&#13;&#10;    &quot;people&quot;&#13;&#10;END' />
      </column>
