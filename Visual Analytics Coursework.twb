            </column>
            <column caption='p_Change Factor' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Looking after home/family&quot;'>
              <calculation class='tableau' formula='&quot;Looking after home/family&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0xmsdsq1e01q5e10tj3qp0f2o23o'>
            <column caption='Selected Percentage Measure' datatype='real' name='[Calculation_1722724460167168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN  &quot;Poor health&quot; THEN[pct_bad_or_very_bad]&#13;&#10;WHEN &quot;Unemployment&quot; THEN[pct_unemployed_of_total]&#13;&#10;WHEN &quot;Retired&quot; THEN[pct_retired]&#13;&#10;WHEN &quot;Student inactive&quot; THEN[pct_student_inactive]&#13;&#10;WHEN &quot;Looking after home/family&quot; THEN[pct_looking_after_home_family]&#13;&#10;WHEN &quot;Long-term sick/disabled&quot; THEN [pct_long_term_sick_disabled]&#13;&#10;WHEN &quot;Other inactive&quot; THEN [pct_other_inactive]&#13;&#10;END' />
            </column>
            <column caption='Selected Count Measure' datatype='integer' name='[Calculation_1722724461744129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Poor health&quot; THEN[n_bad_or_very_bad]&#13;&#10;WHEN &quot;Unemployment&quot; THEN[n_unemployed]&#13;&#10;WHEN &quot;Retired&quot; THEN[n_retired]&#13;&#10;WHEN &quot;Student inactive&quot; THEN[n_student_inactive]&#13;&#10;WHEN &quot;Looking after home/family&quot; THEN[n_looking_after_home_family]&#13;&#10;WHEN &quot;Long-term sick/disabled&quot; THEN[n_long_term_sick_disabled]&#13;&#10;WHEN &quot;Other inactive&quot; THEN[n_other_inactive]&#13;&#10;END' />
