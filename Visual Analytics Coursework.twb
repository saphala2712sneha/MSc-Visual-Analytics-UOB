    <worksheet name='Scatter - Health Change vs Economic change'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Did changes in economic inactivity align with changes in poor health?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='comparison_combined_health_econ' name='federated.0xmsdsq1e01q5e10tj3qp0f2o23o' />
