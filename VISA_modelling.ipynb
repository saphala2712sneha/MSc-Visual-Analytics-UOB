    "\n",
    "# Helper function\n",
    "def add_comparison_geography(df:pd.DataFrame) -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Create a new geography for comparison.\n",
    "    If LAD changed between 2011 and 2021 then\n",
    "      old code -> successor code\n",
    "      old name -> successor name\n",
    "    If LAD did not change:\n",
    "       keep original code and name\n",
    "    \"\"\"\n",
    "    out = df.copy()\n",
    "\n",
    "    # Replace old LAD code with succesor LAD codes where needed\n",
    "    out[\"comparison_area_code\"]= out[\"area_code\"].replace(old_to_new_code)\n",
    "\n",
    "    # assign correct name to comparison geography\n",
    "    out[\"comparison_area_name\"] = out[\"comparison_area_code\"].map(new_code_to_name)\n",
    "    out[\"comparison_area_name\"] = out[\"comparison_area_name\"].fillna(out[\"area_name\"])\n",
    "\n",
    "    return out\n",
    "\n",
    "def safe_pct(numerator, denominator):\n",
    "    \"\"\"\n",
    "    Calculate percentage safely.\n",
    "\n",
    "    Returns NaN if denominator is 0 or missing,\n",
    "    otherwise returns (numerator / denominator) * 100.\n",
    "    \"\"\"\n",
    "    return np.where(\n",
    "        (denominator == 0) | (denominator.isna()),\n",
    "        np.nan,\n",
    "        (numerator / denominator) * 100\n",
    "    )\n",
    "\n",
    "# Harmonise 2011 health+econ\n",
    "def harmonise_2011_for_compare(df:pd.DataFrame) ->pd.DataFrame:\n",
    "    out = add_comparison_geography(df)\n",
    "\n",
    "    # 2011 count columns that can be safely added together\n",
    "    count_cols_2011 = [\n",
    "        # Health counts\n",
    "        \"total_persons_health\",\n",
    "        \"n_very_good\",\n",
    "        \"n_good\",\n",
    "        \"n_fair\",\n",
    "        \"n_bad\",\n",
    "        \"n_very_bad\",\n",
    "        \"n_bad_or_very_bad\",\n",
    "\n",
    "        # Economic activity counts\n",
    "        \"total_persons_econ\",\n",
    "        \"n_active_total\",\n",
    "        \"n_employee_part_time\",\n",
    "        \"n_employee_full_time\",\n",
    "        \"n_self_emp_with_employees_part_time\",\n",
    "        \"n_self_emp_with_employees_full_time\",\n",
    "        \"n_self_emp_without_employees_part_time\",\n",
    "        \"n_self_emp_without_employees_full_time\",\n",
    "        \"n_unemployed\",\n",
    "        \"n_full_time_student_active\",\n",
    "        \"n_inactive_total\",\n",
    "        \"n_retired\",\n",
    "        \"n_student_inactive\",\n",
    "        \"n_looking_after_home_family\",\n",
    "        \"n_long_term_sick_disabled\",\n",
    "        \"n_other_inactive\"\n",
    "    ]\n",
    "\n",
    "    # Group by new comparison geography\n",
    "    agg = (\n",
    "        out.groupby([\"comparison_area_code\", \"comparison_area_name\"], as_index=False)[count_cols_2011]\n",
    "        .sum()\n",
    "        .rename(columns={\n",
    "            \"comparison_area_code\":\"area_code\",\n",
    "            \"comparison_area_name\": \"area_name\"\n",
    "        })\n",
    "    )\n",
    "    \n",
    "    # Flag whether this area cam from booundary change\n",
    "    agg[\"boundary_changed\"] = agg[\"area_code\"].isin(new_code_to_name.keys())\n",
    "\n",
    "    # Recalculate all 2011 percentage from aggregate counts\n",
    "    agg[\"pct_very_good\"] = safe_pct(agg[\"n_very_good\"], agg[\"total_persons_health\"])\n",
    "    agg[\"pct_good\"] = safe_pct(agg[\"n_good\"], agg[\"total_persons_health\"])\n",
    "    agg[\"pct_fair\"] = safe_pct(agg[\"n_fair\"], agg[\"total_persons_health\"])\n",
    "    agg[\"pct_bad\"] = safe_pct(agg[\"n_bad\"], agg[\"total_persons_health\"])\n",
    "    agg[\"pct_very_bad\"] = safe_pct(agg[\"n_very_bad\"], agg[\"total_persons_health\"])\n",
    "    agg[\"pct_bad_or_very_bad\"] = safe_pct(agg[\"n_bad_or_very_bad\"], agg[\"total_persons_health\"])\n",
    "\n",
    "    agg[\"pct_active_total\"] = safe_pct(agg[\"n_active_total\"], agg[\"total_persons_econ\"])\n",
    "    agg[\"pct_employee_part_time\"] = safe_pct(agg[\"n_employee_part_time\"], agg[\"total_persons_econ\"])\n",
    "    agg[\"pct_employee_full_time\"] = safe_pct(agg[\"n_employee_full_time\"], agg[\"total_persons_econ\"])\n",
    "    agg[\"pct_self_emp_with_employees_part_time\"] = safe_pct(agg[\"n_self_emp_with_employees_part_time\"], agg[\"total_persons_econ\"])\n",
    "    agg[\"pct_self_emp_with_employees_full_time\"] = safe_pct(agg[\"n_self_emp_with_employees_full_time\"], agg[\"total_persons_econ\"])\n",
    "    agg[\"pct_self_emp_without_employees_part_time\"] = safe_pct(agg[\"n_self_emp_without_employees_part_time\"], agg[\"total_persons_econ\"])\n",
    "    agg[\"pct_self_emp_without_employees_full_time\"] = safe_pct(agg[\"n_self_emp_without_employees_full_time\"], agg[\"total_persons_econ\"])\n",
    "    agg[\"pct_unemployed\"] = safe_pct(agg[\"n_unemployed\"], agg[\"total_persons_econ\"])\n",
    "    agg[\"pct_full_time_student_active\"] = safe_pct(agg[\"n_full_time_student_active\"], agg[\"total_persons_econ\"])\n",
    "    agg[\"pct_inactive_total\"] = safe_pct(agg[\"n_inactive_total\"], agg[\"total_persons_econ\"])\n",
    "    agg[\"pct_retired\"] = safe_pct(agg[\"n_retired\"], agg[\"total_persons_econ\"])\n",
    "    agg[\"pct_student_inactive\"] = safe_pct(agg[\"n_student_inactive\"], agg[\"total_persons_econ\"])\n",
    "    agg[\"pct_looking_after_home_family\"] = safe_pct(agg[\"n_looking_after_home_family\"], agg[\"total_persons_econ\"])\n",
    "    agg[\"pct_long_term_sick_disabled\"] = safe_pct(agg[\"n_long_term_sick_disabled\"], agg[\"total_persons_econ\"])\n",
    "    agg[\"pct_other_inactive\"] = safe_pct(agg[\"n_other_inactive\"], agg[\"total_persons_econ\"])\n",
    "\n",
    "    agg[\"pct_unemployed_of_total\"] = safe_pct(agg[\"n_unemployed\"], agg[\"total_persons_econ\"])\n",
    "\n",
    "    # round percentage columns\n",
    "    pct_cols = [col for col in agg.columns if col.startswith(\"pct_\")]\n",
    "    agg[pct_cols] =agg[pct_cols].round(2)\n",
    "\n",
    "    return agg\n",
    "\n",
