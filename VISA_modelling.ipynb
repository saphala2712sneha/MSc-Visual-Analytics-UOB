   "id": "1f2f37fe",
   "metadata": {},
   "outputs": [],
   "source": [
    "def add_tableau_lad_reference(df):\n",
    "    \"\"\"\n",
    "    Add Tableau recognised LAD code/name fields\n",
    "    Original fields are kept:\n",
    "    - area_code\n",
    "    - area_name\n",
    "\n",
    "    New fields are added:\n",
    "    - area_code_map: use this for Tableau geographic role\n",
    "    - area_name_map: Tableau/reference LAD name for tooltip/checking\n",
    "    - tableau_lad_match_status: whether the row matched the reference\n",
    "\n",
    "    This does not alter census counts, percentages, PCA/UMAP coordinates,\n",
    "    BGMM clusters.\n",
    "    \"\"\"\n",
    "    df =df.copy()\n",
    "    required_cols = {\"area_code\", \"area_name\"}\n",
    "    missing_cols = required_cols -set(df.columns)\n",
    "\n",
    "    if missing_cols:\n",
    "        raise ValueError(f\"Missing required columns: {missing_cols}\")\n",
    "    \n",
    "    # Clean original fields\n",
    "    df[\"area_code\"] = df[\"area_code\"].astype(str).str.strip().str.upper()\n",
    "    df[\"area_name\"] = df[\"area_name\"].astype(str).str.strip()\n",
    "\n",
    "    for col in [\"area_code_map\", \"area_name_map\", \"tableau_lad_match_status\"]:\n",
    "        if col in df.columns:\n",
    "            df = df.drop(columns=[col])\n",
    "    \n",
    "    # Merge reference by LAD code\n",
    "    df = df.merge(\n",
    "        tableau_lad_reference,\n",
    "        left_on=\"area_code\",\n",
    "        right_on=\"area_code_map\",\n",
    "        how=\"left\"\n",
    "    )\n",
    "\n",
    "    # Flag match status\n",
    "    df[\"tableau_lad_match_status\"] = df[\"area_code_map\"].notna().map({\n",
    "        True: \"matched_reference\",\n",
    "        False: \"not_in_tableau_reference\"\n",
    "    })\n",
    "\n",
    "    # Keep original values if a reference match is not found\n",
    "    df[\"area_code_map\"] = df[\"area_code_map\"].fillna(df[\"area_code\"])\n",
    "    df[\"area_name_map\"] = df[\"area_name_map\"].fillna(df[\"area_name\"])\n",
    "\n",
    "    df[\"LAD_Code\"] = df[\"area_code_map\"]\n",
    "    df[\"LAD_Name\"] = df[\"area_name_map\"]\n",
    "\n",
    "    # One name correction used by the sample workbook/geocoding pack\n",
    "    df[\"LAD_Name\"] = df[\"LAD_Name\"].replace({\n",
    "        \"The Vale of Glamorgan\": \"Vale of Glamorgan\"\n",
    "    })\n",
    "\n",
    "    return df\n",
    "    "
   ]
  },
