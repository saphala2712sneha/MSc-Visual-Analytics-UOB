    "# Save lookup table\n",
    "lookup_rows =[]\n",
    "for old_code, new_code in old_to_new_code.items():\n",
    "    lookup_rows.append({\n",
    "        \"old_area_code\":old_code,\n",
    "        \"new_area_code\":new_code,\n",
    "        \"new_area_name\": new_code_to_name[new_code]\n",
    "    })\n",
    "\n",
    "harmonisation_lookup = pd.DataFrame(lookup_rows).sort_values(\n",
