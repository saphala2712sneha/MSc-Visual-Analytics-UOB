   "source": [
    "# PCA + Bayesian Gaussian Mixture for 2011 dataset\n",
    "\n",
    "pca_model = PCA(n_components=6, random_state=42)\n",
    "X_pca = pca_model.fit_transform(X_scaled)\n",
    "\n",
    "# PC1 and PC2 will be used only for display\n",
    "X_pca_display = X_pca[:, :2]\n",
    "\n",
    "print(\"Explained variance ratio:\")\n",
    "for i, v in enumerate(pca_model.explained_variance_ratio_, start=1):\n",
    "    print(f\"PC{i}: {round(v,4)}\")\n",
    "print(\"Total variance explained:\", round(pca_model.explained_variance_ratio_.sum(),4))\n",
    "print(\"Variance shown in 2D display (PC1 + PC2):\", round(pca_model.explained_variance_ratio_[:2].sum(), 4))\n",
    "\n",
    "# Bayesian Gaussian Mixture Model\n",
    "bgmm = BayesianGaussianMixture(\n",
    "    n_components=6,\n",
    "    covariance_type=\"full\",\n",
    "    weight_concentration_prior_type=\"dirichlet_distribution\",\n",
    "    max_iter=1000,\n",
    "    weight_concentration_prior=1.0,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "bgmm.fit(X_pca)\n",
    "\n",
    "bgmm_labels = bgmm.predict(X_pca)\n",
    "bgmm_probs = bgmm.predict_proba(X_pca)\n",
    "bgmm_confidence = bgmm_probs.max(axis=1)\n",
    "\n",
    "print(\"\\n Bayesian GMM cluster counts:\")\n",
    "print(pd.Series(bgmm_labels).value_counts().sort_index())\n",
    "print(\"\\n Bayesian GMM component weights:\")\n",
    "print(np.round(bgmm.weights_,4))\n",
    "\n",
    "# Plot only PC1 vs PC2 but colored by clusters derived from 6 PC space\n",
    "plt.figure(figsize=(10,7))\n",
    "\n",
    "for cluster_id in sorted(np.unique(bgmm_labels)):\n",
    "    cluster_points = X_pca_display[bgmm_labels == cluster_id]\n",
    "    plt.scatter(\n",
    "        cluster_points[:,0],\n",
    "        cluster_points[:,1],\n",
    "        s=35,\n",
    "        alpha=0.8,\n",
    "        label=f\"Cluster{cluster_id}\"\n",
    "    )\n",
    "plt.title(\"PCA 2D Display with BGMM Clusters (2011)\")\n",
    "plt.xlabel(\"PC1\")\n",
    "plt.ylabel(\"PC2\")\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# Export for Tableau\n",
    "\n",
    "projection_bgmm_df = pd.DataFrame({\n",
    "    \"area_code\": area_info[\"area_code\"],\n",
    "    \"area_name\": area_info[\"area_name\"],\n",
    "    \"pc1\": X_pca_display[:, 0],\n",
    "    \"pc2\": X_pca_display[:, 1],\n",
    "    \"bgmm_cluster\":bgmm_labels,\n",
    "    \"bgmm_confidence\":bgmm_confidence\n",
    "})\n",
    "\n",
    "for i in range(X_pca.shape[1]):\n",
    "    projection_bgmm_df[f\"pc{i+1}_full\"] = X_pca[:, i]\n",
    "\n",
    "for i in range(bgmm_probs.shape[1]):\n",
    "    projection_bgmm_df[f\"cluster_prob_{i}\"]=bgmm_probs[:,i]\n",
    "for col in feature_cols:\n",
    "    projection_bgmm_df[col]=df[col]\n",
    "\n",
    "projection_bgmm_df = add_tableau_lad_reference(projection_bgmm_df)\n",
    "\n",
    "output_path = r\"C:\\MSC\\TB-2\\Visual Analytics\\coursework\\datasets\\projection_2011_pca_bgmm.csv\"\n",
    "projection_bgmm_df.to_csv(output_path, index=False)\n",
    "\n",
    "print(\"\\nSaved to:\")\n",
    "print(output_path)\n"
   ]
