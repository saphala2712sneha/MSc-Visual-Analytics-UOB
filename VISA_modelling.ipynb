    "# Tableau LAD reference alignment\n",
    "\n",
    "tableau_lad_ref_path = r\"C:\\MSC\\TB-2\\Visual Analytics\\coursework\\datasets\\Full_Data_Unique_LAD.csv\"\n",
    "\n",
    "def load_tableau_lad_reference(path): \n",
    "    ref = pd.read_csv(path)\n",
    "    ref.columns = ref.columns.str.strip()\n",
    "\n",
    "    # Keep only the two LAD reference columns\n",
    "    ref = ref[\n",
    "        [\"Local Area District Code\", \"Local Area District Name\"]\n",
    "    ].copy()\n",
    "    \n",
    "\n",
    "    ref.columns = [\"area_code_map\", \"area_name_map\"]\n",
    "\n",
    "    ref[\"area_code_map\"] = (\n",
    "        ref[\"area_code_map\"].astype(str).str.strip().str.upper()\n",
    "    )\n",
    "\n",
    "    ref[\"area_name_map\"] = (\n",
    "        ref[\"area_name_map\"].astype(str).str.strip()\n",
    "    )\n",
    "    \n",
    "    ref = ref.dropna(subset=[\"area_code_map\"])\n",
    "    ref = ref[ref[\"area_code_map\"] != \"\"]\n",
    "    ref = ref.drop_duplicates(subset=[\"area_code_map\"])\n",
    "\n",
    "    print(\"Tableau LAD reference loaded:\", ref.shape)\n",
    "    print(ref.head())\n",
    "\n",
    "    return ref\n",
    "\n",
    "tableau_lad_reference = load_tableau_lad_reference(tableau_lad_ref_path)"
   ]
  },
